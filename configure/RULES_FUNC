ifndef VERBOSE
  QUIET := @
endif

ifdef DEBUG_SHELL
  SHELL = /bin/sh -x
endif

VARS_EXCLUDES += QUIET SHELL

# Generates playbook targets: bare name (vacua scope) and per-vacuum form.
# ANSIBLE_LIMIT overrides the vacuum limit for arbitrary generated VM names.
# Usage: $(call playbook_targets, target_name, playbook_path)
define playbook_targets
.PHONY: $(1) $(1).check

$(1): check-inventory-source ## Run $(2)
	$(QUIET) $(ANSIBLE_PLAYBOOK) $(_base_opts) $(2)

$(1).check: check-inventory-source ## Dry run $(2)
	$(QUIET) $(ANSIBLE_PLAYBOOK) $(_base_opts) -C $(2)

$(foreach os,$(OS_GROUPS),$(eval $(call playbook_vacuum_targets,$(1),$(2),$(os))))
endef

# Usage: $(call playbook_vacuum_targets, target_name, playbook_path, vacuum)
define playbook_vacuum_targets
.PHONY: $(1).$(3) $(1).$(3).check

$(1).$(3): check-inventory-source ## Run $(2) on the $(3) vacuum
	$(QUIET) $(ANSIBLE_PLAYBOOK) $(_base_opts) \
	    $(if $(ANSIBLE_LIMIT),,--limit $(3)) $(2)

$(1).$(3).check: check-inventory-source ## Dry run $(2) on the $(3) vacuum
	$(QUIET) $(ANSIBLE_PLAYBOOK) $(_base_opts) \
	    $(if $(ANSIBLE_LIMIT),,--limit $(3)) -C $(2)
endef

VARS_EXCLUDES += playbook_targets playbook_vacuum_targets
