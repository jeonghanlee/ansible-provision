.DEFAULT_GOAL := help

.PHONY: help help.detail ping check-inventory-source \
	check-runtime-inventory-contract

##@ Help

help: ## Show the operator workflow
	$(info Usage: make <target> [VAR=value])
	$(info )
	$(info Workflows)
	$(info   Stage          Action)
	$(info   ------------   ------------------------------------------------)
	$(info   Host setup     make setup)
	$(info   Connectivity   make ping)
	$(info   Provision      make <species>[.<vacuum>])
	$(info   Operators      make op.<operator>[.<vacuum>])
	$(info   Dry run        make <species>[.<vacuum>].check)
	$(info )
	$(info   Species:       $(SPECIES_PLAYBOOKS))
	$(info   Operators:     op.<name> for $(OPERATOR_PLAYBOOKS))
	$(info   Vacua:         $(OS_GROUPS))
	$(info )
	$(info Details: make help.detail)
	$(QUIET) :

help.detail: ## Show the full target reference
	$(QUIET) awk ' \
	    BEGIN { section = "" } \
	    /^##@/ { \
	        section = substr($$0, 5); \
	        if (seen++) printf "\n"; \
	        printf "%s\n", section; \
	        next; \
	    } \
	    /^[a-zA-Z._0-9%-]+:/ { \
	        msg = $$0; \
	        if (sub(/^[^:]*:.* ## /, "", msg)) { \
	            split($$0, t, ":"); \
	            printf "  %-26s %s\n", t[1], msg; \
	        } \
	    }' $(MAKEFILE_LIST)
	$(QUIET) printf "\n%s\n" "Pattern targets"
	$(QUIET) printf "  %-26s %s\n" "<species>"               "Run a species assembly (vacua scope)"
	$(QUIET) printf "  %-26s %s\n" "<species>.<vacuum>"      "Run a species assembly on one vacuum"
	$(QUIET) printf "  %-26s %s\n" "op.<operator>"           "Run one operator playbook"
	$(QUIET) printf "  %-26s %s\n" "op.<operator>.<vacuum>"  "Run one operator on one vacuum"
	$(QUIET) printf "  %-26s %s\n" "<target>.check"          "Dry-run form of any target above"
	$(QUIET) printf "\n%s\n" "Examples"
	$(QUIET) printf "  make bare.rocky8\n"
	$(QUIET) printf "  make iocrunner.debian13\n"
	$(QUIET) printf "  make epics_dev.ubuntu24 ANSIBLE_LIMIT=lab-ubuntu24-epics-dev-run\n"
	$(QUIET) :

##@ Provisioning

check-inventory-source:
	$(QUIET) if [ "$(INVENTORY)" = "inventory/lab.ini" ] && \
	    [ -z "$(RUNTIME_INVENTORY)" ]; then \
	    printf "%s\n" "Error: RUNTIME_INVENTORY is required with inventory/lab.ini." >&2; \
	    exit 1; \
	fi
	$(QUIET) if [ -n "$(RUNTIME_INVENTORY)" ] && \
	    [ ! -f "$(RUNTIME_INVENTORY)" ]; then \
	    printf "Error: runtime inventory not found: %s\n" "$(RUNTIME_INVENTORY)" >&2; \
	    exit 1; \
	fi

##@ Connectivity

ping: check-inventory-source ## Verify connectivity to all nodes (honors ANSIBLE_LIMIT)
	$(QUIET) $(ANSIBLE_CMD) all -i $(INVENTORY) $(_runtime_inventory_opt) \
	    $(_limit_opt) -m raw -a "uptime"

check-runtime-inventory-contract: ## Verify generated inventory Make preflight
	$(QUIET) bash $(TOP)/tests/check-runtime-inventory-contract.bash

$(foreach sp,$(SPECIES_PLAYBOOKS),$(eval $(call playbook_targets,$(sp),$(PLAYBOOK_DIR)/species/$(sp).yml)))
$(foreach op,$(OPERATOR_PLAYBOOKS),$(eval $(call playbook_targets,op.$(op),$(PLAYBOOK_DIR)/operators/$(op).yml)))

FORCE:
