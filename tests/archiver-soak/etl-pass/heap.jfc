<?xml version="1.0" encoding="UTF-8"?>
<configuration version="2.0" label="ETL soak GC" description="Heap occupancy and GC pauses" provider="Local soak">
  <event name="jdk.GCHeapSummary"><setting name="enabled">true</setting></event>
  <event name="jdk.GarbageCollection"><setting name="enabled">true</setting><setting name="threshold">0 ns</setting></event>
  <event name="jdk.GCPhasePause"><setting name="enabled">true</setting><setting name="threshold">0 ns</setting></event>
  <event name="jdk.DataLoss"><setting name="enabled">true</setting></event>
</configuration>
